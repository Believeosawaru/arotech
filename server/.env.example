NODE_ENV=development
PORT=5000
APP_MODE=test
MONGODB_URI=mongodb://127.0.0.1:27017/arotech
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
PAYSTACK_SECRET_KEY=
# Only for local development / explicit test deployments. NEVER in real-money environments.
ENABLE_SANDBOX_FAUCET=true
# Optional SMTP for verification and password reset flows
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Arotech <no-reply@example.test>
# Seed secrets for local test accounts; change before seeding a shared environment
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
